generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  queued
  approved
  applied
  responded
  interview
  rejected
  offer
}

model User {
  id                     String   @id @default(cuid())
  email                  String   @unique
  passwordHash           String // bcrypt hash — see src/lib/auth/password.ts
  masterResume           String // free-text resume content used as the base for tailoring
  masterResumeFileName   String? // optional uploaded resume file name
  masterResumeFileData   String? // optional uploaded resume, base64-encoded
  coverLetterTemplates   String // JSON array of { tone: string, body: string }
  targetRoles            String // JSON array of strings
  targetLocations        String // JSON array of strings
  salaryFloor            Int? // in INR
  excludedCompanies      String // JSON array of strings
  dailyGoal              Int      @default(50)
  scheduleEnabled        Boolean  @default(false)
  scheduleTimes          String   @default("[]") // JSON array of IST "HH:MM" strings; auto-refresh runs at these times
  apiKeys                String   @default("[]") // JSON array of { provider, label, key } — bring-your-own AI provider keys
  preferredProvider      String   @default("gemini") // which apiKeys entry (by provider) to use for tailoring
  plan                   String   @default("free") // free | pro — gates variant count, schedule slots, model quality
  referralCode           String   @unique @default(cuid()) // shareable code — 3 successful signups via this code auto-upgrades to pro
  referredById           String? // id of the user whose referral link this account signed up through
  isAdmin                Boolean  @default(false) // gates access to /admin insights panel
  autoApproveEnabled     Boolean  @default(false) // Pro: auto-move top matches from queued -> approved at scheduled runs (never auto-submits to the employer)
  autoApproveMinScore    Int      @default(50)
  autoApproveMaxPerRun   Int      @default(20)
  codingProfiles         String   @default("[]") // JSON array of { platform, url } — LeetCode/GitHub/etc, shown on your profile
  gmailConnected         Boolean  @default(false)
  gmailEmail             String? // which Gmail address is connected, for display only
  gmailRefreshToken      String? // OAuth refresh token — same storage tradeoff as bring-your-own apiKeys (plaintext in DB)
  gmailLastSyncedAt      DateTime?

  referredBy  User?  @relation("Referrals", fields: [referredById], references: [id])
  referrals   User[] @relation("Referrals")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  applications Application[]
  matches      Match[]
}

// A discovered/verified public job board (Greenhouse token or Lever handle)
// that the aggregator pulls from. Populated by auto-discovery probing.
model Board {
  id           String   @id @default(cuid())
  source       String // greenhouse | lever
  slug         String // company token / handle
  label        String? // human-friendly company name
  active       Boolean  @default(true)
  lastJobCount Int      @default(0)
  lastCheckedAt DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([source, slug])
}

model JobListing {
  id          String   @id @default(cuid())
  source      String // greenhouse | lever | remoteok | adzuna | manual
  externalId  String // id from the source system, used for de-duplication
  title       String
  company     String
  location    String?
  url         String
  description String
  postedDate  DateTime?
  salaryRange String?
  fetchedAt   DateTime @default(now())

  applications Application[]
  matches      Match[]

  @@unique([source, externalId])
  @@index([company, title])
}

model Application {
  id               String            @id @default(cuid())
  userId           String
  jobListingId     String
  status           ApplicationStatus @default(queued)
  resumeVersion    String? // tailored resume text snapshot used for this application
  coverLetterVersion String? // tailored cover letter text snapshot used for this application
  attachedResumeName String? // file name of a resume attached to this specific application
  attachedResumeData String? // attached resume, base64-encoded
  appliedAt        DateTime?
  lastUpdated      DateTime          @updatedAt
  notes            String?
  followUpDate     DateTime?
  createdAt        DateTime          @default(now())
  selectedVariantId  String? // which ApplicationVariant is currently active in the review UI
  appliedVariantLabel String? // label ("A"/"B"/"C") of the variant selected at the moment status became "applied" — frozen for A/B analytics attribution

  user       User       @relation(fields: [userId], references: [id])
  jobListing JobListing @relation(fields: [jobListingId], references: [id])
  variants   ApplicationVariant[]

  @@unique([userId, jobListingId])
  @@index([userId, status])
}

// A single AI-generated resume/cover-letter variant for an application. Pro
// plan users can generate multiple (A/B/C) to test which lands more
// responses — see Application.appliedVariantLabel for outcome attribution.
model ApplicationVariant {
  id                 String   @id @default(cuid())
  applicationId      String
  label              String // "A" | "B" | "C"
  tone               String?
  resumeVersion      String
  coverLetterVersion String
  createdAt          DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, label])
}

// Server-side record of a long-lived refresh token so it can be revoked
// (logout, admin action) instead of remaining valid until natural expiry —
// unlike the short-lived access token, which is a stateless signed JWT with
// no DB-side kill switch.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // sha256 of the plaintext cookie value — never store it raw
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  rating    Int? // 1-5 stars, optional
  message   String
  page      String? // which page the feedback was submitted from
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Match {
  id             String   @id @default(cuid())
  userId         String
  jobListingId   String
  relevanceScore Float
  reasons        String // JSON array of strings explaining the score
  createdAt      DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  jobListing JobListing @relation(fields: [jobListingId], references: [id])

  @@unique([userId, jobListingId])
  @@index([userId, relevanceScore])
}
